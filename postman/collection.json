    {
      "name": "Cadastrar Ingrediente",
      "event": [
        {
          "listen": "test",
          "script": {
            "id": "e8d21575-9086-44c9-95b8-6a61d1593a5f",
            "exec": [
              "",
              "// Teste de sucesso - Status 201",
              "pm.test(\"Status 201 - Ingrediente cadastrado com sucesso\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "if (pm.response.code === 201) {",
              "    const json = pm.response.json();",
              "",
              "    pm.test(\"Resposta contém id do ingrediente\", function () {",
              "        pm.expect(json).to.have.property(\"id\");",
              "        pm.expect(json.id).to.be.a(\"number\");",
              "    });",
              "",
              "    pm.test(\"Resposta contém name\", function () {",
              "        pm.expect(json).to.have.property(\"name\");",
              "        pm.expect(json.name).to.be.a(\"string\");",
              "    });",
              "",
              "    pm.test(\"Resposta contém brand\", function () {",
              "        pm.expect(json).to.have.property(\"brand\");",
              "        pm.expect(json.brand).to.be.a(\"string\");",
              "    });",
              "",
              "    pm.test(\"Resposta contém unit\", function () {",
              "        pm.expect(json).to.have.property(\"unit\");",
              "        pm.expect(json.unit).to.be.a(\"string\");",
              "    });",
              "",
              "    pm.test(\"Resposta contém novaClassification\", function () {",
              "        pm.expect(json).to.have.property(\"novaClassification\");",
              "        pm.expect(json.novaClassification).to.be.a(\"string\");",
              "    });",
              "",
              "    pm.test(\"Resposta contém compositionLabel\", function () {",
              "        pm.expect(json).to.have.property(\"compositionLabel\");",
              "        pm.expect(json.compositionLabel).to.be.a(\"string\");",
              "    });",
              "",
              "    pm.test(\"Resposta contém purchasePrice\", function () {",
              "        pm.expect(json).to.have.property(\"purchasePrice\");",
              "    });",
              "",
              "    pm.test(\"Resposta contém purchaseQuantity\", function () {",
              "        pm.expect(json).to.have.property(\"purchaseQuantity\");",
              "    });",
              "",
              "    pm.test(\"Resposta contém createdAt\", function () {",
              "        pm.expect(json).to.have.property(\"createdAt\");",
              "        pm.expect(json.createdAt).to.be.a(\"string\");",
              "    });",
              "",
              "    pm.test(\"Resposta contém updatedAt\", function () {",
              "        pm.expect(json).to.have.property(\"updatedAt\");",
              "        pm.expect(json.updatedAt).to.be.a(\"string\");",
              "    });",
              "}",
              "",
              "if (pm.response.code === 400) {",
              "    pm.test(\"Status 400 - Erro de validação retornado\", function () {",
              "        pm.response.to.have.status(400);",
              "    });",
              "",
              "    pm.test(\"Resposta de erro contém mensagem\", function () {",
              "        const json = pm.response.json();",
              "        pm.expect(json).to.satisfy(function (body) {",
              "            return body.hasOwnProperty(\"message\") || body.hasOwnProperty(\"error\");",
              "        });",
              "    });",
              "}",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
