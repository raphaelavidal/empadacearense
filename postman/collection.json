    {
      "name": "Cadastrar Receita",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "if (pm.response.code === 201) {",
              "    const json = pm.response.json();",
              "    pm.test(\"Receita criada possui ID e campos básicos\", function () {",
              "        pm.expect(json).to.have.property(\"id\");",
              "        pm.expect(json.id).to.be.a(\"number\");",
              "        pm.expect(json.name).to.equal(\"Empada de Frango Clássica\");",
              "        pm.expect(json.prepTime).to.equal(45);",
              "        pm.expect(json).to.have.property(\"classification\");",
              "        pm.expect(json.classification).to.equal(\"Natural\");",
              "    });",
              "",
              "    pm.test(\"Lista de ingredientes achatada e sem IDs internos do banco\", function () {",
              "        pm.expect(json).to.have.property(\"ingredients\");",
              "        pm.expect(json.ingredients).to.be.an(\"array\");",
              "        pm.expect(json.ingredients[0]).to.have.property(\"quantity\");",
              "        pm.expect(json.ingredients[0]).to.have.property(\"compositionLabel\");",
              "        pm.expect(json.ingredients[0]).to.have.property(\"isNovaVerified\");",
              "        pm.expect(json.ingredients[0]).to.not.have.property(\"recipeId\");",
              "    });",
              "",
              "    pm.test(\"Resposta contém passos estruturados e ordenados\", function () {",
              "        pm.expect(json).to.have.property(\"steps\");",
              "        pm.expect(json.steps).to.be.an(\"array\");",
              "        pm.expect(json.steps[0]).to.have.property(\"order\");",
              "        pm.expect(json.steps[0]).to.have.property(\"description\");",
              "        pm.expect(json.steps[0].order).to.equal(1);",
              "    });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
