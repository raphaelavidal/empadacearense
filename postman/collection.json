        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"Empada de Frango Clássica\",\n    \"description\": \"Nossa empada de frango com tempero especial cearense.\",\n    \"yield\": 12.00,\n    \"yieldUnit\": \"UNIT\",\n    \"prepTime\": 45,\n    \"category\": \"Salgados\",\n    \"prepMethod\": \"Prepare a massa podre, monte e asse.\",\n    \"ingredients\": [\n        {\n            \"ingredientId\": 1,\n            \"quantity\": 250.00\n        }\n    ],\n    \"steps\": [\n        {\n            \"order\": 1,\n            \"description\": \"Prepare a massa podre com farinha e manteiga.\"\n        },\n        {\n            \"order\": 2,\n            \"description\": \"Refogue o recheio de frango e monte a empada.\"\n        },\n        {\n            \"order\": 3,\n            \"description\": \"Asse por 30 minutos em forno a 200 graus.\"\n        }\n    ]\n}"
