generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UnitType {
  G
  KG
  ML
  L
  UNIT
}

enum NovaClassification {
  NOVA_1
  NOVA_2
  NOVA_3
  NOVA_4
}

model Ingredient {
  id                 Int                 @id @default(autoincrement())

  name               String
  brand              String?

  unit               UnitType

  novaClassification NovaClassification

  compositionLabel   String              @db.Text

  isNovaVerified     Boolean             @default(false)

  purchasePrice      Decimal             @db.Decimal(10,2)
  purchaseQuantity   Decimal             @db.Decimal(10,2)

  calories           Decimal?            @db.Decimal(10,2)
  proteins           Decimal?            @db.Decimal(10,2)
  carbs              Decimal?            @db.Decimal(10,2)
  fats               Decimal?            @db.Decimal(10,2)
  fiber              Decimal?            @db.Decimal(10,2)

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  recipes            RecipeIngredient[]
}

model Recipe {
  id           Int                @id @default(autoincrement())
  name         String
  description  String?            @db.Text
  
  yield        Decimal            @db.Decimal(10,2)
  yieldUnit    UnitType           @default(UNIT)
  
  prepTime     Int
  category     String
  
  prepMethod   String?            @db.Text
  
  ingredients  RecipeIngredient[]
  steps        RecipeStep[]
  
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model RecipeStep {
  id           Int        @id @default(autoincrement())
  
  recipeId     Int
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  
  order        Int
  description  String     @db.Text
  
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([recipeId, order])
}

model RecipeIngredient {
  id           Int        @id @default(autoincrement())
  
  recipeId     Int
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  
  ingredientId Int
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  
  quantity     Decimal    @db.Decimal(10,2)
  
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([recipeId, ingredientId])
}

model OperationalCostConfig {
  id               Int      @id @default(autoincrement())
  
  hourlyRate       Decimal  @db.Decimal(10,2)
  profitMargin     Decimal  @db.Decimal(10,2)
  operationalTax   Decimal  @db.Decimal(10,2)
  packagingCost    Decimal  @db.Decimal(10,2)
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}